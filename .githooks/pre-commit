#!/bin/bash
# GCodeKit6 Pre-commit Hook
# Runs formatting and linting before commit; tests run in CI
# Skip with: git commit --no-verify
# Install with: git config core.hooksPath .githooks

set -e

echo "Running pre-commit checks..."
echo ""

# 1. Check formatting
echo "[1/2] Checking code formatting..."
if ! cargo fmt --check >/dev/null 2>&1; then
    echo "✗ Formatting check failed. Run 'cargo fmt' to fix."
    exit 1
fi
echo "✓ Formatting OK"
echo ""

# 2. Run clippy
echo "[2/2] Running clippy lints (as CI does)..."
if ! cargo clippy --workspace --all-targets -- -D warnings -W clippy::unwrap_used 2>/dev/null; then
    echo "✗ Clippy found warnings. Fix them before committing."
    exit 1
fi
echo "✓ Clippy OK"
echo ""

# Tests are left to CI (`cargo nextest run --workspace`); run them locally
# before pushing when a change needs them.

echo "✓ All pre-commit checks passed!"
exit 0
